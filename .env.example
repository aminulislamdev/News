# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-string-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000

# MongoDB (recommended: one connection string including the database name)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority

# Optional legacy fallback, used only when MONGODB_URI is not set
# DB_USER=your-database-user
# DB_PASSWORD=your-database-password
# MONGODB_HOST=your-cluster-host
# MONGODB_DB=news
